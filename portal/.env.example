# Copy this file to .env and replace EVERY placeholder with your own values.
# .env is git-ignored. Never commit real keys.
# See ADMIN_SETUP_AND_FLOW.md for the Clerk admin-role setup.

# ---------- Neon (database) ----------
# Neon dashboard -> Connect -> choose "Pooled connection" -> copy the connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require
# Optional: max connections in the pool (default 3)
PG_POOL_MAX=3

# ---------- Clerk (login) ----------
# Clerk dashboard -> API keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
# NOTE: there is no ADMIN_EMAIL setting. The admin is the Clerk user whose
# publicMetadata is { "role": "admin" }. Grant it with:
#   npm run admin:role -- --email owner@clinic.com --role admin
# or set it in Clerk dashboard -> Users -> (user) -> Public metadata.

# ---------- Cloudflare R2 (product photos) ----------
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=your-bucket-name
# Public address of the bucket, no trailing slash, e.g. https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ---------- Razorpay (payments) - use rzp_test_ keys while testing ----------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
# Optional: secret you type when creating the webhook in Razorpay (so paid orders are saved even if the customer closes the browser)
RAZORPAY_WEBHOOK_SECRET=

# ---------- Local dev server ----------
# Optional: port for the API in `npm run dev` (default 3001)
API_PORT=3001
